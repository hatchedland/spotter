# Google Gemini API key (https://aistudio.google.com/apikey). Server-only: never prefix with NEXT_PUBLIC_.
# Put the real value in .env.local (gitignored), never in this file; the repo is public.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the Gemini model used for machine recognition and form review.
VISION_MODEL=gemini-3.8-flash
